{
  "name": "libavjs-webcodecs-polyfill",
  "version": "0.5.5",
  "description": "A WebCodecs polyfill (ponyfill, really), using libav.js",
  "main": "dist/libavjs-webcodecs-polyfill.js",
  "types": "src/main.ts",
  "exports": {
    "types": "./src/main.ts",
    "import": "./dist/libavjs-webcodecs-polyfill.mjs",
    "default": "./dist/libavjs-webcodecs-polyfill.js"
  },
  "scripts": {
    "build": "tsc && rollup -c",
    "clean": "rm -rf dist/",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ennuicastr/libavjs-webcodecs-polyfill.git"
  },
  "keywords": [
    "webcodecs",
    "ffmpeg",
    "audio",
    "video",
    "encoding",
    "decoding"
  ],
  "author": "Yahweasel",
  "license": "0BSD",
  "bugs": {
    "url": "https://github.com/ennuicastr/libavjs-webcodecs-polyfill/issues"
  },
  "homepage": "https://github.com/ennuicastr/libavjs-webcodecs-polyfill#readme",
  "dependencies": {
    "@diffusionstudio/core": "^4.0.2",
    "@libav.js/types": "^6.7.7",
    "@ungap/global-this": "^0.4.4",
    "node-av": "^5.0.2"
  },
  "devDependencies": {
    "@libav.js/variant-webm-vp9": "=6.7.7",
    "@rollup/plugin-commonjs": "^25.0.7",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@rollup/plugin-terser": "^0.4.4",
    "@types/node": "^24.10.1",
    "@types/sharp": "^0.31.1",
    "canvas": "^3.2.0",
    "node-web-audio-api": "^1.0.7",
    "rollup": "^4.12.0",
    "sharp": "^0.34.5",
    "tsx": "^4.21.0",
    "typescript": "^5.2.2",
    "vitest": "^4.0.14"
  }
